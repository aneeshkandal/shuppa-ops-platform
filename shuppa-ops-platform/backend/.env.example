# Copy this file to backend/.env and fill in your own values if you don't
# want to use the default dev database baked into app/config.py.

DATABASE_URL=postgresql://<user>:<password>@<host>/<dbname>?sslmode=require&channel_binding=require
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Session 7: login security ---
# JWT_SECRET_KEY: set a real random value before ENVIRONMENT=production - the
# app refuses to start in production with the built-in dev default.
JWT_SECRET_KEY=
ENVIRONMENT=development
FRONTEND_BASE_URL=http://localhost:3000

# SMTP: optional. Leave SMTP_HOST blank to have forgot-password just log the
# reset link to the backend console instead of emailing it (fine for local
# testing). Fill these in to send real reset emails - see README.md's
# "Login security (Session 7)" section.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@shuppa.example.com
SMTP_USE_TLS=true
